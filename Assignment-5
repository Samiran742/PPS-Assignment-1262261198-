//Write a menu driven program program in C to perform all string operations (In built function).


#include <stdio.h>
#include <string.h>

int main()
{
    char str1[100], str2[100], result[200];
    int choice;

    printf("STRING OPERATIONS\n");
    printf("1. Find Length\n");
    printf("2. Copy String\n");
    printf("3. Concatenate Strings\n");
    printf("4. Compare Strings\n");
    printf("5. Reverse String\n");

    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    switch(choice)
    {
        case 1:
            printf("Enter a string: ");
            scanf("%99s", str1);

            printf("Length = %lu", strlen(str1));
            break;

        case 2:
            printf("Enter a string: ");
            scanf("%99s", str1);

            strcpy(str2, str1);

            printf("Copied string = %s", str2);
            break;

        case 3:
            printf("Enter first string: ");
            scanf("%99s", str1);

            printf("Enter second string: ");
            scanf("%99s", str2);

            strcpy(result, str1);
            strcat(result, str2);

            printf("Concatenated string = %s", result);
            break;

        case 4:
            printf("Enter first string: ");
            scanf("%99s", str1);

            printf("Enter second string: ");
            scanf("%99s", str2);

            if(strcmp(str1, str2) == 0)
                printf("Strings are equal");
            else
                printf("Strings are not equal");
            break;

        case 5:
            printf("Enter a string: ");
            scanf("%99s", str1);

            strrev(str1);

            printf("Reversed string = %s", str1);
            break;

        default:
            printf("Invalid choice!");
    }

    return 0;
}
